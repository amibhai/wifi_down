# WiFi Auditor — Scope Authorization Record (template)
#
# This is a MANUAL record template for your own engagement paperwork / audit
# trail. Copy it to scope.yaml and document the networks you are authorized to
# test. NOTE: the tool does not currently read or enforce this file — it is a
# documentation aid, not an access control. You remain solely responsible for
# testing only in-scope networks.
#
# LEGAL NOTICE: Only list networks you own or have EXPLICIT WRITTEN PERMISSION
# to test. Unauthorized access is a criminal offence (CFAA / UK CMA / India IT
# Act 2000).

authorized_targets:
  - bssid: "AA:BB:CC:DD:EE:FF"
    ssid: "YourNetworkName"
    authorized_by: "Full Name (relationship: owner / written-permission)"
    valid_until: "YYYY-MM-DD"
    notes: "Source of authorization: e.g. written email dated YYYY-MM-DD"
